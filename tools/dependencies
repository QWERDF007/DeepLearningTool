# Runtime dependency link list.
# Each section declares a root directory directly or reads it from a CMake config file:
#   cmake=<cmake config path>
#   root=<absolute/relative path or CMake variable name>
# File entries are relative to root. Supported keys: windows, linux, macos, all.
# Add one or more dest entries to link matched files into each output directory.

[sqlite]
cmake=cmake/ConfigSQLite.cmake
root=CMAKE_PREFIX_PATH
dest=build/bin
windows=lib/sqlite3.dll
linux=lib/libsqlite3.so
linux=lib/libsqlite3.so.*
macos=lib/libsqlite3.dylib

